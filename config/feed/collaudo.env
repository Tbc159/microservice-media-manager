# Variabili NON sensibili del dominio feed in collaudo.
# Questo dominio non ha segreti: e' pubblico, in sola lettura, e non autentica nulla.
APP_ENV=collaudo
LOG_LEVEL=info

# Verifica delle firme BIP-340 degli eventi. Tenerla accesa: il feed accetta relay dal
# chiamante (?relays=) e senza verifica un relay ostile puo' iniettare episodi altrui.
FEED_VERIFY_SIGNATURES=1
