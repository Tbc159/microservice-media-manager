# Variabili NON sensibili del dominio content in production (i secret stanno nelle GitHub Environments)
APP_ENV=production
LOG_LEVEL=warning
REQUEST_TIMEOUT_SECONDS=30

# Generazione immagini: URL interno del dominio source sulla rete docker 'mediamgr'
SOURCE_INTERNAL_URL=http://source:8080/v0/source

# Cartella dei font Montserrat (non versionati). Senza i TTF -> fallback al font Pillow.
FONTS_DIR=/app/fonts
