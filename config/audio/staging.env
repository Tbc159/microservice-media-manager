# Variabili NON sensibili del dominio audio in staging (i secret stanno nelle GitHub Environments)
APP_ENV=staging
LOG_LEVEL=info
REQUEST_TIMEOUT_SECONDS=600

# Elaborazione: URL interno del dominio source sulla rete docker 'mediamgr'
SOURCE_INTERNAL_URL=http://source:8080/v0/source

# Job store persistente + worker in background
AUDIO_DB_PATH=/data/audio.db
AUDIO_START_WORKER=1
FFMPEG_BIN=ffmpeg
